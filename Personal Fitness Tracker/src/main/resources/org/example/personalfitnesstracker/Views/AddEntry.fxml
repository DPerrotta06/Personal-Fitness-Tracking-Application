<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="297.0" prefWidth="331.0" spacing="15" style="-fx-background-color: black; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.personalfitnesstracker.Controllers.AddEntryController">

    <Label style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" text="Add Entry" />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" text="Entry Type:" />

        <ComboBox fx:id="entryTypeCombo" prefHeight="25.0" prefWidth="168.0" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" text="Value:" />

        <TextField fx:id="valueField" prefWidth="200" promptText="Enter number" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" text="Notes:" />

        <TextArea fx:id="notesField" prefHeight="18.0" prefWidth="200" promptText="Optional notes" />
    </HBox>

    <Button fx:id="saveButton" style="-fx-background-color: #1435d1; -fx-text-fill: white;                    -fx-font-size: 14; -fx-background-radius: 8;                    -fx-padding: 10 20;" text="Save Entry" />

</VBox>
